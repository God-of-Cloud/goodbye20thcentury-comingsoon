{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "app/main.tsx",
    "app/page.tsx",
    "components/portfolio/**/*.tsx",
    "vite.pages.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "work",
    ".tools"
  ]
}
